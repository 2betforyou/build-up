#!/bin/zsh

script_dir="${0:A:h}"
if [[ -n "${BUILDUP_PYTHON:-}" ]]; then
  buildup_python="$BUILDUP_PYTHON"
elif [[ -x "$script_dir/.venv/bin/python" ]]; then
  buildup_python="$script_dir/.venv/bin/python"
elif [[ -x "/opt/homebrew/anaconda3/bin/python3" ]]; then
  buildup_python="/opt/homebrew/anaconda3/bin/python3"
else
  buildup_python="python3"
fi
exec "$buildup_python" "$script_dir/router/run_buildup.py" "$@"
