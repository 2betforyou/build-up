# Local model endpoints and models
BUILDUP_BASE_DIR=~/.buildup
BUILDUP_OLLAMA_URL=http://localhost:11434/api/chat
BUILDUP_OLLAMA_EMBED_URL=http://localhost:11434/api/embed
BUILDUP_OLLAMA_HEALTH_URL=http://localhost:11434/api/tags
BUILDUP_FAST_MODEL=gemma4:e4b
BUILDUP_MAIN_MODEL=qwen3.8:27b
BUILDUP_RESEARCH_MODEL=qwen3.8:27b
BUILDUP_REVIEWER_MODEL=deepseek-r1:32b
BUILDUP_CODER_MODEL=qwen3.8:27b
BUILDUP_EMBED_MODEL=nomic-embed-text
BUILDUP_STRUCT_MODEL=qwen2.5:1.5b

# Search: auto | tavily | brave | exa | openalex | searxng | google | browser
BUILDUP_SEARCH_PROVIDER=auto
BUILDUP_SEARCH_TIMEOUT=30
BUILDUP_SEARCH_CACHE_TTL_HOURS=24
BUILDUP_SEARCH_LANG=auto
BUILDUP_RESPECT_ROBOTS_TXT=true
BUILDUP_TAVILY_SEARCH_DEPTH=basic
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
EXA_API_KEY=
# Free registered key with a limited daily API budget; scholarly discovery only.
OPENALEX_API_KEY=
BUILDUP_SEARXNG_URL=
# Existing Google CSE customers only; service shutdown is scheduled for 2027-01-01.
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=

# Optional local browser discovery
BUILDUP_BROWSER_SEARCH_ENABLED=false
BUILDUP_BROWSER_SEARCH_ENGINE=google
BUILDUP_BROWSER_HEADLESS=true

# Research budgets
BUILDUP_RESEARCH_DEPTH=auto
BUILDUP_RESEARCH_MAX_ROUNDS=3
BUILDUP_RESEARCH_MAX_TASKS=8
BUILDUP_RESEARCH_MAX_SEARCHES=24
BUILDUP_RESEARCH_MAX_SOURCES=30
BUILDUP_RESEARCH_MAX_MODEL_CALLS=20
BUILDUP_RESEARCH_MAX_CONCURRENCY=4
BUILDUP_RESEARCH_MAX_RUNTIME_SECONDS=1800
BUILDUP_RESEARCH_MIN_COVERAGE=0.85
BUILDUP_RESEARCH_SOURCE_CHARS=100000
BUILDUP_RESEARCH_EVIDENCE_PASSAGE_CHARS=4000
BUILDUP_MAX_PDF_BYTES=52428800

# Compounding Knowledge Vault (non-destructive defaults)
BUILDUP_KNOWLEDGE_AUTO_INGEST=true
BUILDUP_KNOWLEDGE_AUTO_COMPILE=true
BUILDUP_KNOWLEDGE_AUTO_LINT=true
# auto_verify, destructive edit, and cross-vault sharing are intentionally unavailable.

# Optional Open WebUI integration
OPENWEBUI_BASE_URL=http://localhost:3000
OPENWEBUI_TOKEN=
OPENWEBUI_KB_RESEARCH=
OPENWEBUI_KB_CODING=
OPENWEBUI_KB_OPS=
